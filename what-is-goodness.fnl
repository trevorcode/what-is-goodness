(macro module [name & body]
  `(local ,name
    (do
      ,(unpack body))))

(var current-scene nil)

(fn round [x]
  (math.floor (+ x 0.5)))

(fn intersects [a b]
  (and (< a.x (+ b.x b.width))
       (< a.y (+ b.y b.height))
       (< b.x (+ a.x a.width))
       (< b.y (+ a.y a.height))))

(fn lerp [start end percent]
  (+ start (* (- end start) percent)))

(fn ease-in [t]
  (* t t t))

(fn ease-in-out [t]
  (if (< t 0.5)
      (* 4 t t t)
      (- 1 (* 4 (- 1 t) (- 1 t) (- 1 t)))))

(fn dir-to [a b]
  (let [dx (- b.x a.x)
        dy (- b.y a.y)
        len (math.sqrt (+ (* dx dx) (* dy dy)))]
    (if (< 0 len)
        [(/ dx len) (/ dy len)]
        [0 0])))

;; "frames, width height, frame-duration in number of frames, loop"
(fn make-animation [frames w h frame-duration loop?] 
  [frames w h frame-duration loop?])

(fn make-animator [init-animation]
  {:frame 0
   :frame-timer 0
   :animation init-animation
   :finished? false})

(fn animator-frame-id [animator]
  (. (. animator.animation 1) (+ 1 animator.frame)))

(fn set-animation! [animator animation]
  (when (not= animator.animation animation)
    (doto animator
      (tset :frame 0)
      (tset :frame-timer 0)
      (tset :animation animation)
      (tset :finished? false))))

(fn update-animation! [animator]
  (when (and (not animator.finished?) animator.animation)
    (let [[frames _ _ frame-duration loop] animator.animation]
      (when (<= frame-duration animator.frame-timer)
        (do
          (set animator.frame-timer 0)
          (if (and (not loop) (= (+ animator.frame 1) (length frames)))
              (set animator.finished? true)
              (set animator.frame (% (+ animator.frame 1) (length frames))))))

      (set animator.frame-timer (+ 1 animator.frame-timer))
      animator)))

(local bg "")

(local bg-no-pole "")

(var pixel-address (* 0x08000 2));; start as map RAM area
(var bg-start-address 0x8000)
(var bg-no-pole-start-address 0xBFC0) ;; This is derived by adding the start address to 16320 (the number of bytes for 240x136 in vram (two colors per byte))

(fn decode-rle [str]
  (local address-start pixel-address)
  (for [i 1 (length str) 2]
    (let [count (tonumber (string.sub str i i))
          color (tonumber (string.sub str (+ 1 i) (+ 1 i)))]
      (for [j 1 count]
        (poke4 pixel-address color)
        (set pixel-address (+ 1 pixel-address)))))
  address-start)

(var current-phase :phase6)

(fn increase-current-phase! []
  (set current-phase
       (case current-phase
         :phase1 :phase2
         :phase2 :phase3
         :phase3 :phase4
         :phase4 :phase5
         :phase5 :phase6
         :phase6 :phase7)))

(fn phase->number [phase]
  (case phase
    :phase1 1
    :phase2 2
    :phase3 3
    :phase4 4
    :phase5 5
    :phase6 6))

(module worlds
  (var next-id 0)

  (fn add [world entity]
    (set entity.world world)
    (set entity.id next-id)
    (set next-id (+ 1 next-id))
    (table.insert world.entities entity))

  (fn remove [entity]
    (set entity.destroy? true))

  (fn delete-tagged [world]
    (for [i (length world.entities) 1 -1]
      (when (. world.entities i :destroy?)
        (table.remove world.entities i))))

  {: add : remove : delete-tagged})

(module scenes
  (local scene-list {})
  (var scenes [])
  (var scene-pop-counter 0)
  (var scenes-to-push [])

  (fn add-scene! [key scene-constructor]
    (tset scene-list key scene-constructor))

  (fn push-scene! [scene]
    (table.insert scenes-to-push 1 [:push scene]))

  (fn pop-scene! []
    (set scene-pop-counter (+ 1 scene-pop-counter)))

  (fn set-scene! [scene]
    (table.insert scenes-to-push 1 [:set scene]))

  (fn swap-root-scene! [new-scene]
    (when new-scene.init
      (new-scene.init))
    (tset scenes (length scenes) new-scene))

  (fn run-scenes! []
    (when (> (length scenes) 0)
      (let [top (. scenes 1)]
        (top.input)
        (top.update)
        (for [i (length scenes) 1 -1]
          (let [s (. scenes i)]
            (s.render)))))

    (for [i 1 scene-pop-counter]
      (table.remove scenes 1))
    (set scene-pop-counter 0)

    (each [_ [action s] (ipairs scenes-to-push)]
      (match action
        :set (set scenes [s])
        :push (table.insert scenes 1 s))
      (when s.init
        (s.init)))

    (set scenes-to-push []))

  {: push-scene! : pop-scene! : set-scene!
   : swap-root-scene! : run-scenes! : add-scene!
   : scene-list})

(module projectiles
 (fn make-shield-projectile [x y target]
   {:x x :y y
    :dx 0 :dy -5
    :width 6 :height 6
    :type :projectile
    :time 0
    :target target
    :update (fn [self]
              (set self.time (+ 1 self.time))
              (set self.x (+ self.dx self.x))
              (set self.y (+ self.dy self.y))
              (let [dir (dir-to self self.target)]
                (set self.dx (* 0.98 (+ self.dx (* 0.1 (. dir 1)))))
                (set self.dy (* 0.98 (+ self.dy (* 0.1 (. dir 2))))))

              (when (< 180 self.time)
                (worlds.remove self))
              )
    :render (fn [self] (circ self.x self.y 4 14))})

(fn make-phase-3-projectile [x y target]
   {:x x :y y
    :dx 0 :dy 0
    :width 6 :height 6
    :type :projectile
    :time 0
    :target target
    :update (fn [self]
              (set self.time (+ 1 self.time))
              (set self.x (+ self.dx self.x))
              (set self.y (+ self.dy self.y))
              (let [dir (dir-to self self.target)]
                (set self.dx (* 0.98 (+ self.dx (* 0.1 (. dir 1)))))
                (set self.dy (* 0.98 (+ self.dy (* 0.1 (. dir 2))))))

              (when (< 180 self.time)
                (worlds.remove self))
              )
    :render (fn [self] (circ self.x self.y 4 12))})

(fn make-fire [x y]
   {:x x :y y
    :dx 0 :dy 1
    :width 6 :height 6
    :type :projectile
    :time 0
    :update (fn [self]
              (set self.time (+ 1 self.time))
              (set self.x (+ self.dx self.x))
              (set self.y (+ self.dy self.y))

              (when (< 130 self.time)
                (worlds.remove self)))
    :render (fn [self] (circ self.x self.y 4 10))})

 (fn make-slash [x y]
   (local slash-time 8)
   {:x x :y y
    :width 8 :height 36
    :type :projectile
    :time 0
    :update (fn [self]
              (set self.time (+ 1 self.time))
              (when (< 8 self.time)
                (worlds.remove self)))
    :render (fn [self] (rect self.x self.y self.width self.height 13))})

 (fn make-strike [boss]
   {:x boss.x :y boss.y
    :width 8 :height 24
    :type :projectile
    :remove (fn [self]
              (worlds.remove self))
    :update (fn [self]
              (set self.x boss.x)
              (set self.y boss.y))
    :render (fn [self] (rect self.x self.y self.width self.height 11))})

 {: make-shield-projectile : make-slash : make-phase-3-projectile
  : make-strike : make-fire}
 )

(module boss
  (local run-animation (make-animation [32 34] 2 2 20 true))
  (local shield-animation (make-animation [36] 2 2 20 true))
  (local speed 1)
  (local boss-phase-hp 2)
  (var current-strategy nil)
  (var other-coroutines [])

  (fn wait [frames]
    (fn [boss]
      (for [i 1 frames]
        (coroutine.yield))))

  (fn move! [x]
    (fn [boss]
      (while (not= boss.x x)
        (let [dir (if (< boss.x x) :right :left)]
          (set boss.x (+ boss.x (* speed (if (= dir :right) 1 -1))))
          (coroutine.yield)))))

  (fn shield [boss]
    (set-animation! boss.animator shield-animation)
    ((wait 10) boss)
    (table.insert
     other-coroutines
     (coroutine.create 
      (fn [boss]
        (set boss.shielding? true)
        ((wait 200) boss)
        (set boss.shielding? false)))))

  (fn phase-3-attack [boss]
    ((wait 50) boss)

    (local start-x boss.x)
    (local start-y boss.y)

    (for [i 1 50]
      (set boss.y (lerp start-y (- start-y 50) (ease-in-out (/ i 50))))
      (coroutine.yield))

    ((wait 80) boss)
    (worlds.add boss.world (projectiles.make-phase-3-projectile boss.x boss.y boss.world.player))
    ((wait 20) boss)

    (worlds.add boss.world (projectiles.make-phase-3-projectile boss.x boss.y boss.world.player))
    ((wait 20) boss)

    (worlds.add boss.world (projectiles.make-phase-3-projectile boss.x boss.y boss.world.player))
    ((wait 20) boss)

    (for [i 1 50]
      (set boss.y (lerp (- start-y 50) start-y (ease-in-out (/ i 50))))
      (coroutine.yield))
    )

(fn phase-4-attack [boss]
    (local start-x boss.x)
    (local start-y boss.y)

    (local strike (projectiles.make-strike boss))
    (worlds.add boss.world strike)
    (for [i 1 50]
      (set boss.x (lerp start-x (+ start-x 15) (ease-in-out (/ i 50))))
      (coroutine.yield))

    ((wait 80) boss)

    (let [cur-x boss.x]
      (for [i 1 20]
        (set boss.x (lerp cur-x 15 (/ i 20)))
        (coroutine.yield)))

    ((wait 80) boss)

    (let [cur-x boss.x]
      (for [i 1 20]
        (set boss.x (lerp cur-x start-x (/ i 20)))
        (coroutine.yield)))
    (strike:remove)
    )

(fn phase-5-attack [boss]

    (local start-x boss.x)
    (local start-y boss.y)

    (for [i 1 50]
      (set boss.x (lerp start-x 110 (ease-in-out (/ i 50))))
      (set boss.y (lerp start-y 50 (ease-in-out (/ i 50))))
      (coroutine.yield))

    (for [i 1 8]
      (for [j 1 8]
        (worlds.add boss.world (projectiles.make-fire (- (* 40 j) (if (= 0 (% i 2)) 40 25)) 10)))
      ((wait 60) boss))

    ((wait 80) boss)
    
    (let [cur-x boss.x
          cur-y boss.y]
      (for [i 1 50]
        (set boss.x (lerp cur-x start-x (ease-in-out (/ i 50))))
        (set boss.y (lerp cur-y start-y (ease-in-out (/ i 50))))
        (coroutine.yield)))
    )

(fn phase-6-attack [boss]
    (local start-x boss.x)
    (local start-y boss.y)

    (fn strike-down []
      (set boss.x boss.world.player.x)
      (set boss.y 40)
      ((wait 20) boss)
      (let [cur-y boss.y
            strike (projectiles.make-strike boss)]
        (worlds.add boss.world strike)
        (for [i 1 30]
          (set boss.y (lerp cur-y start-y (ease-in (/ i 30))))
          (coroutine.yield))
        (strike:remove)
        ((wait 20) boss)))

    (fn strike-across []
      (local r (math.random 2))
      (set boss.x (if (= r 1) 216 0))
      (local target-x (if (= r 1) 0 216))
      ((wait 40) boss)
      (let [cur-x boss.x
            strike (projectiles.make-strike boss)]
        (worlds.add boss.world strike)
        (for [i 1 50]
          (set boss.x (lerp cur-x target-x (ease-in (/ i 50))))
          (coroutine.yield))
        (strike:remove)
        ((wait 20) boss)))

    (for [i 1 6]
      (if (= 1 (math.random 2))
          (strike-across)
          (strike-down))
      )
    (set boss.x start-x)
    (set boss.y start-y))

  (fn attack-string [boss]
    (for [i 1 8]
      (worlds.add boss.world (projectiles.make-slash (- boss.x 20) (- boss.y 16)))
      ((wait 50) boss)
      ((move! (- 240 (* i 20))) boss))
    
    ((move! 200) boss))

  (fn fw-bw-move! [boss]
    (set-animation! boss.animator run-animation)
    ((move! 140) boss)
    ((move! 200) boss))

  (fn move-to-start-defeat [boss]
    (local start-x boss.x)
    (local start-y boss.y)
    (set-animation! boss.animator run-animation)
    (for [i 1 50]
      (set boss.x (lerp start-x 200 (ease-in-out (/ i 50))))
      (set boss.y (lerp start-y 110 (ease-in-out (/ i 50))))
      (coroutine.yield))
    (scenes.push-scene! 
     ((. scenes :scene-list :make-dialogue-scene)
      (case (phase->number current-phase)
        1 :phase1-win
        2 :phase2-win
        3 :phase3-win
        4 :phase4-win
        5 :phase5-win
        6 :phase6-win)
      (fn []
        (when (< (phase->number current-phase) 6)
          (increase-current-phase!)
          (scenes.push-scene!
           ((. scenes :scene-list :make-transition-screen)
            (fn [] (scenes.swap-root-scene! ((. scenes :scene-list :make-pre-boss-scene)))))))
        (when (= (phase->number current-phase) 6)
          (set boss.world.phase-6-win? true))))))

  (fn wait-30-frames [boss]
    ((wait 30) boss))

  (fn ability-list [phase tutorial?]
    (local phase-abilities [shield
                            attack-string
                            phase-3-attack
                            phase-4-attack
                            phase-5-attack
                            phase-6-attack])

    (local abilities [fw-bw-move! wait-30-frames])

    (if tutorial?
        (. phase-abilities phase)
        (do 
          (for [i 1 phase]
            (table.insert abilities (. phase-abilities i)))
          abilities)))

  (fn damage [boss]
    (when (and (not boss.invulnerable)
               (not boss.shielding?))
      (set boss.health (- boss.health 1))
      (set boss.invulnerable 30)))

  (fn update [boss]
    (update-animation! boss.animator)
    (when boss.invulnerable
      (set boss.invulnerable (- boss.invulnerable 1))
      (when (= boss.invulnerable 0)
        (set boss.invulnerable nil)))

    (when (< boss.health 0)
      (set boss.health boss-phase-hp)
      (set boss.phases-left (- boss.phases-left 1))
      (when (= 0 boss.phases-left)
        (set boss.fighting? false)
        (set boss.defeated? true)
        (each [_ e (ipairs boss.world.entities)]
          (when (= e.type :projectile)
            (worlds.remove e)))
        (set current-strategy (coroutine.create move-to-start-defeat))))

    (each [_ e (ipairs boss.world.entities)]
      (when (and (= e.type :player-slash)
                 (intersects e boss))

        (when boss.shielding?
          (worlds.add boss.world (projectiles.make-shield-projectile boss.x boss.y boss.world.player)))

        (damage boss)))

    (when (and boss.fighting?
               (or (not current-strategy)
                   (= :dead (coroutine.status current-strategy))))
      (let [abilities (ability-list (phase->number current-phase) false)
            random-ability (.  abilities (math.random (length abilities)))]
        (set current-strategy (coroutine.create random-ability))))

    (when current-strategy 
      (coroutine.resume current-strategy boss))

    (set other-coroutines
         (icollect [_ c (ipairs other-coroutines)]
           (if (= :dead (coroutine.status c))
               nil
               (do (coroutine.resume c boss) c)))))

  (fn render [boss]
    (let [animator boss.animator
          [frames w h] animator.animation
          frame-id (animator-frame-id animator)]
      (when boss.defeated?
        (for [c 0 15] (poke4 (+ (* 0x3ff0 2) c) 8)))
      (if (and boss.invulnerable (= 0 (% (// boss.invulnerable 5) 2))) 
        nil
        (spr frame-id boss.x boss.y 0 1 (if (= boss.direction :left) 1 0) 0 w h))
      (when boss.defeated?
        (for [c 0 15] (poke4 (+ (* 0x3ff0 2) c) c))))

    (when boss.shielding?
      (circb (+ boss.x 7) (+ boss.y 7) 12 14)))

  (fn make-boss [phase]
    (set current-strategy nil)
    (set other-coroutines [])

    {:x 200 :y 110
     :type :boss
     :width 16 :height 16
     :direction :left
     :update update
     :render render
     :health boss-phase-hp
     :phases-left (case phase
                    :phase1 1
                    :phase2 2
                    :phase3 3
                    :phase4 4
                    :phase5 5
                    :phase6 6)
     :animator (make-animator run-animation)})

  {: make-boss})

(module player-module
  (local jump-force -4)
  (local ground-y 110)
  (local speed 1.5)
  (local gravity 0.2)
  (local roll-speed 3)
  (local run-animation (make-animation [6 8] 2 2 10 true))
  (local idle-animation (make-animation [2] 2 2 20 true))
  (local roll-animation (make-animation [66 68 70 72] 2 2 5 true))
  (local attack-animation (make-animation [4] 2 2 5 true))
  (local jump-animation (make-animation [10] 2 2 5 true))
  (local slash-animation (make-animation [256 257 258 259 260 261 262] 1 2 1 false))
  (var current-routine nil)

  (fn cutscene-move! [x f]
    (set current-routine
         (coroutine.create
          (fn [player]
            (set player.state :running)
            (while (not (< (- x 2) player.x (+ x 2)))
              (let [dir (if (< player.x x) :right :left)]
                (set player.x (+ player.x (* speed (if (= dir :right) 1 -1))))
                (coroutine.yield)))
            (set current-routine nil)
            (set player.state :idle)
            (f)))))

  (fn damage [player]
    (when (not player.invulnerable)
      (set player.health (- player.health 1))
      (set player.invulnerable 30)))

  (fn spawn-slash [player]
    (worlds.add player.world
                {:update (fn [self]
                           (update-animation! self.animator)

                           (when self.animator.finished?
                             (worlds.remove self)))
      :render (fn [self]
                (let [animator self.animator
                      [frames w h] animator.animation
                      frame-id (animator-frame-id animator)]
                  ;;(rect self.x self.y self.width self.height 13)
                  (spr frame-id
                       (- self.x 4)
                       self.y 0 2
                       (if (= self.direction :right) 0 1)
                       0 w h))

                )
      :direction player.direction
      :animator (make-animator slash-animation)
      :x (+ (if (= player.direction :right) 16 -8) player.x)
      :y (- player.y 8)
      :height 32 :width 8
      :type :player-slash}))

  (fn move-player-x! [player pos?]
    (when (not= player.state :rolling)
      (let [new-x (+ player.x (* speed (if pos? 1 -1)))]
        (when (and player.grounded?
                   (not= player.state :running)
                   (not= player.state :attacking))
          (tset player :state :running))
        (tset player :direction (if pos? :right :left))
        (tset player :x new-x))))

  (fn jump! [player]
    (when (and player.grounded?
               (not= player.state :rolling)) 
      (doto player
        (tset :state :jumping)
        (tset :grounded? false)
        (tset :y (- player.y 1))
        (tset :vy jump-force))))

  (fn dodge-roll! [player roll?]
    (when (not= player.state :rolling)
      (let [roll-dir roll?]
        (doto player 
          (tset :state :rolling)
          (tset :rolling-info [roll-dir 25])
          (tset :vy -0.5)))))

  (fn attack! [player]
    (when (not= player.state :rolling)
      (set player.state :attacking)
      (set player.attack-timer 8)
      (spawn-slash player)))

  (fn update-player! [player pos?]
    (when current-routine
      (coroutine.resume current-routine player))

    (set-animation!
     player.animator
     (case player.state
       :running run-animation
       :jumping jump-animation
       :idle idle-animation
       :attacking attack-animation
       :rolling roll-animation))

    (when (< player.y ground-y)
      (set player.vy (+ player.vy gravity)))

    (when (<= ground-y player.y)
      (when (not player.grounded?)
        (set-animation! player.animator idle-animation))
      (set player.grounded? true)
      (set player.y ground-y)
      (set player.vy 0))

    (when player.invulnerable
      (set player.invulnerable (- player.invulnerable 1))
      (when (= player.invulnerable 0)
        (set player.invulnerable nil)))

    (each [_ e (ipairs player.world.entities)]
      (when (and (= e.type :projectile)
                 (intersects e player)
                 (not player.invulnerable))
        (set player.health (- player.health 1))
        (set player.invulnerable 30)))

    (when (= player.state :attacking)
      (set player.attack-timer (- player.attack-timer 1))
      (when (= player.attack-timer 0)
        (set player.state :idle)
        (set-animation! player.animator idle-animation)))

    (when (= player.state :rolling)
      (let [rolling player.rolling-info
            [dir time] player.rolling-info]
        (set (. rolling 2) (- time 1))
        (set player.x (+ player.x (if (= dir :left) (- roll-speed) roll-speed)))
        (when (= time 0)
          (set player.state :idle)
          (set player.rolling-info nil))))

    (update-animation! player.animator)
    (set player.y (+ player.vy player.y)))

  (fn render-player! [player]
    (let [animator player.animator
          [frames w h] animator.animation
          frame-id (animator-frame-id animator)]
      (when (<= player.health 0)
        (for [c 0 15] (poke4 (+ (* 0x3ff0 2) c) 8)))
      (if (and player.invulnerable (= 0 (% (// player.invulnerable 5) 2))) 
        nil
        (spr frame-id player.x player.y 0 1 (if (= player.direction :right) 0 1) 0 w h))
      (when (<= player.health 0)
        (for [c 0 15] (poke4 (+ (* 0x3ff0 2) c) c)))))

  (fn player-input [enabled? player]
    (when enabled? 
      (when (btn 0)
        (jump! player))
      (when (and (= player.state :running)
                 (not (btn 3))
                 (not (btn 2)))
        (set player.state :idle)
        (set-animation! player.animator idle-animation))
      (when (btn 3)
        (move-player-x! player true))
      (when (btn 2)
        (move-player-x! player false))
      (when (btnp 4)
        (attack! player))
      (when (btnp 5)
        (if (btn 2)
            (dodge-roll! player :left)
            (dodge-roll! player :right)))))

  (fn make-player []
    {:x -30 :y 110 :hp 3 :vx 0 :vy 0
     :health 3
     :type :player
     :width 16 :height 16
     :state :idle
     :direction :right
     :grounded? false
     :animator (make-animator run-animation)
     :update update-player!
     :render render-player!})

  {: make-player : move-player-x! : jump! : attack! : dodge-roll!
   : cutscene-move! : player-input})

(module dialogue
  (local script {:phase1
                 [[:player "Do you know the way?"]
                  [:boss "I do not know the way"]
                  [:boss "Teh way"]
                  [:player "What is patience..."]]
                 :phase1-win
                 [[:boss "YOU WIN... PERFECT"]]
                 :phase2
                 [[:player "Do you know the way?"]
                  [:boss "I do not know the way"]
                  [:boss "Teh way"]
                  [:player "What is faith..."]]
                 :phase2-win
                 [[:boss "Well done"]]
                 :phase3
                 [[:player "Do you know the way?"]
                  [:boss "I do not know the way"]
                  [:boss "Teh way"]
                  [:player "What is knowledge..."]]
                 :phase3-win
                 [[:boss "Well done"]]
                 :phase4
                 [[:player "Do you know the way?"]
                  [:boss "I do not know the way"]
                  [:boss "Teh way"]
                  [:player "What is mercy..."]]
                 :phase4-win
                 [[:boss "Nice Job"]]
                 :phase5
                 [[:player "Do you know the way?"]
                  [:boss "I do not know the way"]
                  [:boss "Teh way"]
                  [:player "What is wisdom..."]]
                 :phase5-win
                 [[:boss "Sweet"]]
                 :phase6
                 [[:player "Do you know the way?"]
                  [:boss "I do not know the way"]
                  [:boss "Teh way"]
                  [:player "What is goodness..."]]
                 :phase6-win
                 [[:boss "Go, and take your justice"]]
                 :defeat
                 [[:player "... !"]
                  [:player "I must learn more..."]]
                 })

  (fn draw-bubble [x y]
    (rect x y 24 8 7)
    (print ". . ." x y 1))

  (fn make-dialogue-scene [phase close-fn]
    (var current-line 1)
    (var current-char 1)
    {:input (fn []
              (when (btnp 4)
                (when (= current-line (length (. script phase)))
                  (scenes.pop-scene!)
                  (close-fn))
                (set current-line (math.min (length (. script phase)) (+ current-line 1)))
                (set current-char 1)))
     :update (fn [] (set current-char (+ current-char 1)))
     :render (fn []
               (let [[speaker text] (. script phase current-line)]
                 (if (= speaker :player)
                     (draw-bubble 40 90)
                     (draw-bubble 200 80))
                 (rect 0 0 240 30 7)
                 (print (string.sub text 0 current-char) 0 0 1)))})

  {: make-dialogue-scene})


(fn make-boss-scene []
  (local player (player-module.make-player))
  (local boss (boss.make-boss current-phase))
  (local world {:entities []
                :boss boss
                :player player})
  (worlds.add world player)
  (worlds.add world boss)
  (var fight-state :not-started)

  {:input (fn []
            (player-module.player-input (= :started fight-state) player))
   :init (fn []
           (player-module.cutscene-move!
            50
            (fn []
              (scenes.push-scene! (dialogue.make-dialogue-scene
                                   current-phase
                                   (fn []
                                     (set fight-state :started)
                                     (set boss.fighting? true))))))
           )
   :update (fn []
             (each [_ e (ipairs world.entities)]
               (e:update))

             (when (and (< 240 player.x) (?. world :phase-6-win?))
               (scenes.set-scene! ((. scenes :scene-list :make-justice-scene))))
             
             (when (<= player.health 0)
               (set fight-state :defeated)
               (set boss.fighting? false)
               (scenes.push-scene! 
                (dialogue.make-dialogue-scene
                 :defeat
                 (fn []
                   (scenes.push-scene!
                    ((. scenes :scene-list :make-transition-screen)
                     (fn [] (scenes.swap-root-scene! ((. scenes :scene-list :make-pre-boss-scene))))))))))

             (worlds.delete-tagged world))
   :render (fn []
             (cls 1)
             (when (not (= fight-state :defeated))
                 (memcpy 0 bg-start-address 16320))
             (each [_ e (ipairs world.entities)]
               (e:render))

             (for [i 1 player.health]
               (circ (* i 9) 5 3 1))
             )})

(fn make-justice-scene []
  (local player (player-module.make-player))
  (local world {:entities []
                :player player})
  (worlds.add world player)

  (var show-prompt? false)
  (var option :execute)
  (var fin-sequence false)
  (var flash-white? false)
  (var show-credits? false)

  (fn toggle-option! []
    (if (= option :execute)
        (set option :spare)
        (set option :execute)))

  {:input (fn []
            (when (and show-credits? (btnp 4))
              (scenes.set-scene! ((. scenes :scene-list :make-main-menu-scene)))

              )
            (when show-prompt?
              (when (or (btnp 0) (btnp 1) (btnp 2) (btnp 3))
                (toggle-option!))
              (when (btn 4)
                (set show-prompt? false)
                (set fin-sequence
                     (coroutine.create
                      (if (= option :spare)
                          (fn []
                            (player-module.cutscene-move! 300)
                            (for [i 1 240] (coroutine.yield))
                            (for [i 1 7]
                                (set flash-white? (not flash-white?))
                                (coroutine.yield))
                            (for [i 1 120] (coroutine.yield))
                            (set show-credits? true))

                          (fn []
                            (let [player-y player.y
                                  player-x player.x]
                              (for [i 1 120]
                                (set player.y (lerp player-y (- player-y 5) (ease-in-out (/ i 120))))
                                (set player.x (lerp player-x (- player-x 3) (ease-in-out (/ i 120))))
                                (coroutine.yield))
                              (set player.state :attacking)
                              (set player.attack-timer 30)
                              (for [i 1 8]
                                (coroutine.yield))
                              (for [i 1 7]
                                (set flash-white? (not flash-white?))
                                (coroutine.yield)))
                            (for [i 1 120] (coroutine.yield))
                            (set show-credits? true))))))))
   :init (fn []
           (player-module.cutscene-move! 110
            (fn [] (set show-prompt? true))))
   :update (fn []
             (each [_ e (ipairs world.entities)]
               (e:update))
             (when fin-sequence
               (coroutine.resume fin-sequence))
             )
   :render (fn []
             (cls 5)
             (memcpy 0 bg-no-pole-start-address 16320)
             (each [_ e (ipairs world.entities)]
               (e:render))
             (spr 64 113 112 0 1 0 0 2 2)
             (when flash-white?
               (rect 0 0 240 136 (if (= option :execute) 8 1)))

             (when show-credits?
               (local text-color (if (= option :execute) 1 8))
               (print "A game by" 75 25 text-color)
               (print "Trevor S" 75 55 text-color)
               (print "Eleonor V" 75 65 text-color)
               (print "Press Z to continue" 75 85 text-color)
               )

             (when show-prompt?
               (rect 69 19 82 62 1)
               (rect 70 20 80 60 8)
               (print "Take justice?" 75 25 1)
               (print "Execute" 75 45 1)
               (print "Spare" 75 55 1)

               (local (x-offset y-offset)
                      (if (= option :execute)
                          (values 114 42)
                          (values 100 52)))
               
               (tri (+ 12 x-offset) (+ y-offset 0)
                    (+ 12 x-offset) (+ y-offset 12)
                    (+ 6 x-offset) (+ y-offset 6) 1)
               )

             )}
  )

(fn make-pre-boss-scene []
  (local player (player-module.make-player))
  (local world {:entities []
                :player player})
  (worlds.add world player)

  (var started? false)

  {:input (fn []
            (player-module.player-input started? player))
   :init (fn []
           (player-module.cutscene-move! 50
            (fn [] (set started? true)))
           )
   :update (fn []
             (each [_ e (ipairs world.entities)]
               (e:update))
             (when (< 240 player.x)
               (scenes.set-scene! ((. scenes :scene-list :make-boss-scene))))
             (worlds.delete-tagged world))
   :render (fn []
             (cls 5)
             (memcpy 0 bg-no-pole-start-address 16320)
             (each [_ e (ipairs world.entities)]
               (e:render))
             )}
  )

(fn make-transition-screen [on-swap]
  (local duration 80)
  (var elapsed 0)
  (var phase :out)
  {:input (fn [] true)
   :update (fn []
             (set elapsed (+ 1 elapsed))
             (when (= elapsed 40)
               (set phase :in)
               (on-swap))
             (when (= elapsed duration)
               (scenes.pop-scene!)))
   :render (fn []
             (local y
                    (if (< elapsed (/ duration 2))
                     (lerp 136 0 (ease-in-out (/ elapsed (/ duration 2))))
                     (lerp 0 136 (ease-in-out (/ (- elapsed (/ duration 2)) (/ duration 2))))))
             (rect 0 y 240 136 2))})

(fn make-main-menu-scene []
  {:input (fn []
            (when (btnp 4)
              (scenes.push-scene!
               ((. scenes :scene-list :make-transition-screen)
                (fn [] (scenes.swap-root-scene! ((. scenes :scene-list :make-pre-boss-scene))))))))
   :update (fn [] true)
   :render (fn []
             (cls 1)
             (print "What is goodness?" 20 20 8 false 2)
             (print "Play" 40 70 8 false 1)
             (tri 32 66 32 78 38 72 8))})

(scenes.add-scene! :make-dialogue-scene dialogue.make-dialogue-scene)
(scenes.add-scene! :make-main-menu-scene make-main-menu-scene)
(scenes.add-scene! :make-transition-screen make-transition-screen)
(scenes.add-scene! :make-pre-boss-scene make-pre-boss-scene)
(scenes.add-scene! :make-boss-scene make-boss-scene)
(scenes.add-scene! :make-justice-scene make-justice-scene)


(scenes.set-scene! ((. scenes :scene-list :make-main-menu-scene)))

(fn _G.BOOT []
  (decode-rle bg)
  (decode-rle bg-no-pole))

(fn _G.TIC []
  (scenes.run-scenes!))

